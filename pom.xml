<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.rozlabs</groupId>
  <artifactId>jfrdoc-mcp</artifactId>
  <version>0.2.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mcp.sdk.version>2.0.0</mcp.sdk.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
      <version>${mcp.sdk.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>jfrdoc-mcp</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>jfrdoc.mcp.McpServer</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>

                    <!-- jfrdoc is stdio-only (McpServer.java only ever
                         constructs StdioServerTransportProvider). The MCP
                         SDK's client package and HTTP/SSE-based server
                         transports are never instantiated; excluding them
                         shrinks the shipped jar's attack surface without
                         touching any code path this plugin uses.
                         reactor/** is deliberately NOT excluded: disassembly
                         of the shipped jar confirmed StdioServerTransportProvider
                         and McpSyncServer both depend on it directly. -->
                    <exclude>io/modelcontextprotocol/client/**</exclude>
                    <exclude>io/modelcontextprotocol/server/transport/Http*</exclude>
                    <exclude>io/modelcontextprotocol/server/transport/*Sse*</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
